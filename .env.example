# Database
DATABASE_URL=postgresql://postgres:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/irs_dev?schema=public

# Redis / BullMQ
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
# Worker only: file holding the Redis password (relative paths resolve against the repository root)
# REDIS_PASSWORD_FILE="secrets/redis_password"

# Service Ports
API_PORT="3001"
WEB_PORT="3000"

# Webhook secrets (empty configuration placeholder; set locally, never commit real values)
IRS_WEBHOOK_SECRETS=""
