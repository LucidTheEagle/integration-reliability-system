{
  "name": "@irs/api",
  "version": "1.0.0",
  "private": true,
  "description": "HTTP API for the Integration Reliability System (webhook transport boundary).",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test \"dist/**/*.test.js\"",
    "start": "node --env-file-if-exists=../../.env dist/main.js"
  },
  "dependencies": {
    "@irs/config": "workspace:^",
    "@irs/integrations": "workspace:^",
    "fastify": "5.12.5"
  }
}
