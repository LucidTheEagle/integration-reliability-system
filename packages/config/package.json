{
    "name": "@irs/config",
    "version": "1.0.0",
    "private": true,
    "description": "Validated runtime configuration for the Integration Reliability System.",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "scripts": {
      "build": "tsc -p tsconfig.json",
      "typecheck": "tsc -p tsconfig.json --noEmit",
      "test": "vitest run"
    },
    "dependencies": {
      "zod": "^4.6.5"
    },
    "devDependencies": {
      "vitest": "^5.0.1"
    }
  }