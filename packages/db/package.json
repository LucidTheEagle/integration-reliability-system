{
    "name": "@irs/db",
    "version": "1.0.0",
    "private": true,
    "description": "Database access layer for the Integration Reliability System.",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "scripts": {
      "generate": "prisma generate --config ../../prisma.generate.config.ts",
      "build": "pnpm run generate && tsc -p tsconfig.json",
      "typecheck": "tsc -p tsconfig.json --noEmit",
      "test": "pnpm run build && node --test \"dist/**/!(*.db).test.js\"",
      "test:db": "pnpm run build && node dist/test-support/preflight.js && node --test --test-concurrency=1 \"dist/**/*.db.test.js\""
    },
    "dependencies": {
      "@prisma/adapter-pg": "7.10.0",
      "@prisma/client": "7.10.0"
    }
  }